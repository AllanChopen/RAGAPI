APP_NAME=API RAG
API_PREFIX=/api
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:password@localhost:5432/ragdb

# Proveedor del modelo de lenguaje: huggingface | openai | anthropic | openai_compatible
LLM_PROVIDER=huggingface
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1600

HF_API_TOKEN=
HF_MODEL_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL_NAME=claude-sonnet-5
ANTHROPIC_VERSION=2023-06-01

# Proveedor genérico compatible con OpenAI (Groq, OpenRouter, gateways locales, etc.)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL_NAME=

# Los embeddings son independientes del modelo generativo.
# Soportados: huggingface | openai
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16
OPENAI_EMBEDDING_MODEL_NAME=text-embedding-3-small

RAG_MIN_SIMILARITY=0.15
RAG_MEMORY_TURNS=6
RAG_DEFAULT_TOP_K=8
RAG_CANDIDATE_MULTIPLIER=4
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_REPOSITORY_MAX_FILES=500
RAG_REPOSITORY_MAX_CHUNKS_PER_FILE=50
RAG_COMMIT_MAX_DIFF_FILES=50
RAG_COMMIT_MAX_DIFF_CHUNKS_PER_FILE=5
RAG_COMMIT_MAX_PATCH_CHARS=20000
RAG_DOCUMENT_MAX_CHUNKS_PER_FILE=300
